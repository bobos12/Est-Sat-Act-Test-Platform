# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Needed for payments, admin student tools and question images. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Secret. Long random string; also run `select private.set_server_gate('<same value>');` in the SQL editor.
# Exams and practice then only load through this server, never straight from the Supabase API.
SUPABASE_GATE_SECRET=

# --- Bot protection: Cloudflare Turnstile (dash.cloudflare.com → Turnstile) ---
# Public site key. Put the secret key in Supabase → Authentication → Attack Protection → Turnstile, not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public URL of the site (auth emails, payment redirects and webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Search engine verification (optional; meta tags in <head>) ---
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- AI: knowledge-base analysis and exam generation ---
# Free alternative: Google AI Studio key (used when ANTHROPIC_API_KEY is empty)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-5-5
# ANTHROPIC_MODEL=

# --- Payments: Paymob (Egypt) — Dashboard → Settings → Account info / Security ---
PAYMENT_PROVIDER=paymob
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Comma-separated integration IDs to offer (e.g. card,wallet): 1234567,2345678
PAYMOB_INTEGRATION_IDS=
# Optional: https://accept.paymob.com (Egypt, default)
# PAYMOB_BASE_URL=
